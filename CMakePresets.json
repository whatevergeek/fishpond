{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "FISHPOND_FETCH_JUCE": "OFF"
      }
    },
    {
      "name": "dev-macos",
      "displayName": "Development (macOS)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "juce-fixture-macos",
      "displayName": "JUCE fixture (macOS)",
      "inherits": "base",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FISHPOND_FETCH_JUCE": "ON",
        "FISHPOND_BUILD_JUCE_FIXTURES": "ON",
        "BUILD_TESTING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "app-macos",
      "displayName": "Fishpond desktop app (macOS)",
      "inherits": "base",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FISHPOND_FETCH_JUCE": "ON",
        "FISHPOND_BUILD_APP": "ON",
        "BUILD_TESTING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "juce-fixture-windows",
      "displayName": "JUCE fixture (Windows)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FISHPOND_FETCH_JUCE": "ON",
        "FISHPOND_BUILD_JUCE_FIXTURES": "ON",
        "BUILD_TESTING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "juce-fixture-linux",
      "displayName": "JUCE fixture (Linux)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FISHPOND_FETCH_JUCE": "ON",
        "FISHPOND_BUILD_JUCE_FIXTURES": "ON",
        "BUILD_TESTING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "dev-windows",
      "displayName": "Development (Windows)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-linux",
      "displayName": "Development (Linux)",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-macos",
      "configurePreset": "dev-macos"
    },
    {
      "name": "juce-fixture-macos",
      "configurePreset": "juce-fixture-macos"
    },
    {
      "name": "app-macos",
      "configurePreset": "app-macos"
    },
    {
      "name": "juce-fixture-windows",
      "configurePreset": "juce-fixture-windows"
    },
    {
      "name": "juce-fixture-linux",
      "configurePreset": "juce-fixture-linux"
    },
    {
      "name": "dev-windows",
      "configurePreset": "dev-windows"
    },
    {
      "name": "dev-linux",
      "configurePreset": "dev-linux"
    }
  ],
  "testPresets": [
    {
      "name": "p0-build-contract-macos",
      "configurePreset": "dev-macos",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "BUILD-CONTRACT" } }
    },
    {
      "name": "p0-build-contract-windows",
      "configurePreset": "dev-windows",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "BUILD-CONTRACT" } }
    },
    {
      "name": "p0-build-contract-linux",
      "configurePreset": "dev-linux",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "BUILD-CONTRACT" } }
    }
  ]
}
